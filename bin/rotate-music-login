#!/usr/bin/env python3
"""Set up or check YouTube Music authentication for rotate-music.

You do not normally need to run this: `rotate-music` authenticates itself on
every run. This is the setup and fallback tool.

    --install   register the native messaging host (also run by install.sh)
    --ask       paste a 'Copy as cURL' command; the only path that leaves a
                credential on disk, for when the extension is unavailable
    (default)   check that automatic auth works end to end, then discard it
"""

import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rotate_music_auth as auth  # noqa: E402


def do_install():
    for path in auth.install():
        print(f"registered native host: {path}")
    print(
        f"\nNow load the extension, once:\n"
        f"  1. open chrome://extensions\n"
        f"  2. enable Developer mode\n"
        f"  3. Load unpacked -> {auth.extension_dir()}\n"
        f"\nIt should appear with ID {auth.EXTENSION_ID}."
    )


def do_ask():
    path = auth.auth_file_path()
    print(
        "Login to YouTube Music:\n\n"
        "Please visit the following URL to authenticate with YouTube Music\n\n"
        f"    {auth.YTM}\n\n"
        "After you have authenticated, press F12 to open the developer console.\n"
        "Filter for 'browse' and right click on the first entry and select\n"
        "'Copy > Copy as cURL'.\n\n"
        "Then return to this terminal and press ENTER."
    )
    input()

    curl = subprocess.run(["/usr/bin/pbpaste"], capture_output=True, text=True, check=True).stdout
    headers = auth.parse_curl(curl)

    ok, why = auth.validate(headers)
    if not ok:
        sys.exit(f"pasted headers are unusable: {why}")

    auth.write_headers(path, headers)
    print(f"Wrote headers to {path} ({why}).")
    print("rotate-music will use this file and leave it in place.")


def do_check(timeout):
    headers, source = auth.acquire(timeout=timeout)
    ok, why = auth.validate(headers)
    print(f"Authentication works: {why}, via {source}.")
    if source == "extension":
        print("The credential was discarded, as it is on every rotate-music run.")
    return 0 if ok else 1


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--install", action="store_true", help="register the native host")
    parser.add_argument("--ask", action="store_true", help="paste a cURL command instead")
    parser.add_argument(
        "--timeout", type=int, default=30, help="seconds to wait for the extension (default: 30)"
    )
    args = parser.parse_args()

    try:
        if args.install:
            do_install()
        elif args.ask:
            do_ask()
        else:
            sys.exit(do_check(args.timeout))
    except auth.AuthError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
