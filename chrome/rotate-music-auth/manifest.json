{
  "manifest_version": 3,
  "name": "Rotate Music Auth",
  "version": "1.1.0",
  "description": "Exports YouTube Music session cookies for the rotate-music script.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "externally_connectable": {
    "ids": []
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Refresh rotate-music auth"
  }
}
